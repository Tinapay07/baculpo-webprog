PORT=8000
# Use MONGO_URI in Render. MONGODB_URI and DATABASE_URL are accepted as fallbacks.
# Replace <password> with your Atlas database user's password.
MONGO_URI=mongodb+srv://username:<password>@cluster.mongodb.net/?retryWrites=true&w=majority&appName=Cluster0
MONGO_DB_NAME=baculpo_db
JWT_SECRET=replace-with-a-long-random-secret

# Frontend URL allowed by CORS, for example:
# FRONTEND_ORIGIN=https://your-vercel-app.vercel.app
FRONTEND_ORIGIN=http://localhost:5173

# Optional: comma-separated extra frontend URLs.
# FRONTEND_ORIGINS=https://your-production-domain.com,https://your-preview.vercel.app
FRONTEND_ORIGINS=

# Optional: allow all https://*.vercel.app preview deployments.
ALLOW_VERCEL_PREVIEWS=false
