PORT=8000
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/database
JWT_SECRET=replace-with-a-long-random-secret

# Frontend URL allowed by CORS, for example:
# FRONTEND_ORIGIN=https://your-vercel-app.vercel.app
FRONTEND_ORIGIN=http://localhost:5173

# Optional: comma-separated extra frontend URLs.
# FRONTEND_ORIGINS=https://your-production-domain.com,https://your-preview.vercel.app
FRONTEND_ORIGINS=

# Optional: allow all https://*.vercel.app preview deployments.
ALLOW_VERCEL_PREVIEWS=false
